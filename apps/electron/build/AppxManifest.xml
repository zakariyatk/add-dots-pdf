<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package (MSIX) for Add Dots PDF, built by
     `npm run electron:build:store` (electron-builder's appx target, which
     fills in the ${...} values: the version, from package.json's, and the
     .exe). The identity is fixed here, not taken from electron-builder.yml:
     Identity Name, Publisher and PublisherDisplayName are the ones Partner
     Center gave the product (Product management > Product identity) and the
     Store signs the package itself, so they must match exactly, for it to
     update the same listing (9PGHPBRMLQMS). The tile and logo images are
     build/appx/, put in the package's assets\ folder. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 rescap">

  <Identity
    Name="ADDDOTS.ADDDOTSPDF"
    Publisher="CN=B4571263-B820-4F66-B107-5B0CC5616541"
    Version="${version}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Add Dots PDF</DisplayName>
    <PublisherDisplayName>ADD DOTS</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="${executable}" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Add Dots PDF"
        Description="Read, edit and mark up PDFs"
        BackgroundColor="transparent"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- opens PDFs from Explorer, as the setup .exe's install does; and
             "Combine files in Add Dots PDF" on PDFs picked there, as
             Acrobat has it: Explorer starts it once for each file picked,
             and the app (single instance) gathers them -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF document</uap:DisplayName>
            <uap:Logo>assets\PdfFile.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/pdf">.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="combine" Parameters="--combine &quot;%1&quot;">Combine files in Add Dots PDF...</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- a desktop (Win32) app: the Electron window runs as a normal program -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
